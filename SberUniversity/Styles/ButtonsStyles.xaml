<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="display">
        pack://application:,,,/fonts/#sb-sans-display-semibold.ttf
    </FontFamily>
    <FontFamily x:Key="text">
        pack://application:,,,/fonts/#sb-sans-text-medium.ttf
    </FontFamily>
    
    <Style x:Key="StartButton">
        <Setter Property="Button.Height" Value="122"/>
        <Setter Property="Button.Width" Value="510"/>
        <Setter Property="Canvas.Left" Value="142.5"/>
        <Setter Property="Canvas.Top" Value="1006"/>
        <Setter Property="Button.FontFamily" Value="{DynamicResource text}"/>
        <Setter Property="Button.FontWeight" Value="SemiBold"/>
        <Setter Property="Button.Foreground" Value="#18AA7B"/>
        <Setter Property="Button.FontSize" Value="36"/>
        <Setter Property="Button.HorizontalAlignment" Value="Center"/>
        <Setter Property="Button.BorderBrush" Value="White"/>
        <Setter Property="Button.Background" Value="White"/>
        <Setter Property="Button.FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Button.Focusable" Value="False"/>
        <Setter Property="Button.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="24">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E5FFFFFF"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="EndButton" BasedOn="{StaticResource StartButton}">
        <Setter Property="Canvas.Top" Value="1034" />
        <Setter Property="Button.FontWeight" Value="Regular"/>
    </Style>

    <Style x:Key="Returnbtn">
        <Setter Property="Button.Width" Value="223"/>
        <Setter Property="Button.Height" Value="62"/>
        <Setter Property="Canvas.Top" Value="60"/>
        <Setter Property="Canvas.Right" Value="60"/>
        <Setter Property="Button.FontFamily" Value="{DynamicResource text}"/>
        <Setter Property="Button.FontWeight" Value="Regular"/>
        <Setter Property="Button.Foreground" Value="#FFFFFF"/>
        <Setter Property="Button.FontSize" Value="24"/>
        <Setter Property="Button.Background">
            <Setter.Value>
                <SolidColorBrush Color = "#33FFFFFF"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Button.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="1" CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="border" Property="Background" Value="#59FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="EndButtonV2" BasedOn="{StaticResource Returnbtn}">
        <Setter Property="Button.Width" Value="382"/>
        <Setter Property="Button.Height" Value="94"/>
        <Setter Property="Button.FontSize" Value="24"/>
        <Setter Property="Button.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="White" BorderThickness="2" CornerRadius="24">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                            <Setter TargetName="border" Property="Background" Value="#59FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Sentbtn" BasedOn="{StaticResource StartButton}">
        <Setter Property="Button.Height" Value="109"/>
        <Setter Property="Button.Width" Value="455"/>
        <Setter Property="Canvas.Left" Value="0"/>
        <Setter Property="Canvas.Top" Value="1535"/>
        <Setter Property="Button.FontWeight" Value="Regular"/>
        <Setter Property="Button.Clip">
            <Setter.Value>
                <RectangleGeometry RadiusX="24" RadiusY="24" Rect="0,0,455,109"/>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="GetButton" BasedOn="{StaticResource Sentbtn}">
        <Setter Property="Button.Width" Value="382"/>
        <Setter Property="Button.Height" Value="94"/>
        <Setter Property="Button.FontSize" Value="24"/>
        <Setter Property="Button.Margin" Value="32,0,0,0" />
    </Style>

    <Style x:Key="PoliticsButton" BasedOn="{StaticResource Sentbtn}">
        <Setter Property="Button.Background" Value="#18AA7B"/>
        <Setter Property="Button.Foreground" Value="White"/>
        <Setter Property="Button.Width" Value="338"/>
        <Setter Property="Button.Height" Value="94"/>
        <Setter Property="Button.FontSize" Value="24"/>
        <Setter Property="Canvas.Top" Value="1636"/>
        <Setter Property="Canvas.Left" Value="311"/>
        <Setter Property="Button.Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="24">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#CC18AA7B"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#18AA7B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AgrementButton" BasedOn="{StaticResource PoliticsButton}">
        <Setter Property="Canvas.Top" Value="958"/>
        <Setter Property="Canvas.Left" Value="311"/>
    </Style>

    <Style x:Key="ErrorEndButton" BasedOn="{StaticResource EndButton}">
        <Setter Property="Button.Height" Value="94"/>
        <Setter Property="Button.Width" Value="344"/>
    </Style>
    
    <Style x:Key="TryAgainButton" BasedOn="{StaticResource GetButton}">
        <Setter Property="Button.Height" Value="94"/>
        <Setter Property="Button.Width" Value="344"/>
    </Style>
</ResourceDictionary>